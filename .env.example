# Copy to .env.local for local dev. On Vercel, set these in Project Settings -> Environment Variables.

# ---------- Mode ----------
# true: mock checkout, in-memory licenses, mock email (see /dev/emails).
# false: real Stripe, Postgres, and Resend.
# Unset: mocks everywhere except Vercel Production (VERCEL_ENV=production).
USE_MOCKS=true
# Mock only: buyer email used by mock checkout (default buyer@example.com).
MOCK_BUYER_EMAIL=

# ---------- Site ----------
# Public origin for Stripe success/cancel URLs and links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Direct .dmg download. Defaults to the latest GitHub release asset.
NEXT_PUBLIC_DOWNLOAD_URL=

# ---------- Stripe (sandbox keys first) ----------
# The price's product needs an eligible tax code for managed payments
# (e.g. txcd_10202000, downloadable software).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_1UbTYAAZAvtzPdJvM78Ogexf
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`, or the Dashboard endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...

# ---------- Postgres (Neon via Vercel Marketplace) ----------
# Apply the schema with: npm run db:migrate
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---------- Email (Resend; verify spinespy.com first) ----------
RESEND_API_KEY=re_...
LICENSE_FROM_EMAIL=hello@spinespy.com
